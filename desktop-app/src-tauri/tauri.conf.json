{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Box Lite",
  "version": "0.2.0",
  "identifier": "com.david.ai-command-hub-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "The Box Lite",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "url": "lite.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "One quiet workspace for your local AI tools"
  }
}
